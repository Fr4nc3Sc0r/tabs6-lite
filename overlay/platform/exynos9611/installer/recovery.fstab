# Recovery fstab for Samsung Exynos 9611 devices (non-A/B, dynamic partitions).
# Block device names follow the stock partition table of the Galaxy Tab S6 Lite
# (LineageOS android_device_samsung_gta4xl-common, configs/init/fstab.exynos9611).
#<src>	<mnt_point>	<type>	<mnt_flags and options>	<fs_mgr_flags>
system	/system	erofs	ro	logical,first_stage_mount
system	/system	ext4	ro	logical,first_stage_mount
vendor	/vendor	erofs	ro	logical,first_stage_mount
vendor	/vendor	ext4	ro	logical,first_stage_mount
product	/product	erofs	ro	logical,first_stage_mount
product	/product	ext4	ro	logical,first_stage_mount
odm	/odm	erofs	ro	logical,first_stage_mount
odm	/odm	ext4	ro	logical,first_stage_mount
/dev/block/by-name/boot	/boot	emmc	defaults	recoveryonly
/dev/block/by-name/recovery	/recovery	emmc	defaults	recoveryonly
/dev/block/by-name/dtbo	/dtbo	emmc	defaults	recoveryonly
/dev/block/by-name/vbmeta	/vbmeta	emmc	defaults	recoveryonly
/dev/block/by-name/super	/super	emmc	defaults	recoveryonly
/dev/block/by-name/metadata	/metadata	ext4	defaults	wait,first_stage_mount
/dev/block/by-name/userdata	/data	f2fs	noatime,nosuid,nodev,discard,usrquota,grpquota,fsync_mode=nobarrier,reserve_root=32768,resgid=5678	recoveryonly
/dev/block/by-name/cache	/cache	ext4	defaults	recoveryonly
/dev/block/by-name/efs	/efs	ext4	defaults	recoveryonly
/dev/block/by-name/misc	/misc	emmc	defaults	recoveryonly
/dev/block/by-name/prism	/prism	ext4	defaults	recoveryonly
/dev/block/by-name/optics	/optics	ext4	defaults	recoveryonly
